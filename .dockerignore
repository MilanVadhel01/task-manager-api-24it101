# ─────────────────────────────────────────────
# .dockerignore — backend build context
# Excludes secrets, host dependencies and junk
# from the image and from the build cache.
# ─────────────────────────────────────────────

# Host-installed dependencies — the image runs
# `npm ci --omit=dev` inside the container
node_modules/

# Secrets — NEVER copy the real .env into the image.
# MONGO_URI is provided by docker-compose.yml at runtime.
# (.env.example stays available as documentation.)
.env
.env.*
!.env.example

# Version control / CI
.git/
.github/
.gitignore

# Docker files themselves are not needed inside the image
Dockerfile
.dockerignore

# Logs and coverage output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage/
.nyc_output/

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local AI context doc (not part of the app)
context.md
